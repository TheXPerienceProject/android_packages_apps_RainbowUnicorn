<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title=" ">

    <mx.xperience.unicorn.RainbowHeaderPreference
        android:key="rainbow_header"
        android:selectable="false"
        android:layout="@layout/rainbow_dashboard_header" />

    <!-- Status bar / Quick Settings -->
    <Preference
        android:key="statusbar_category"
        android:title="@string/statusbar_title"
        android:summary="@string/statusbar_summary"
        android:fragment="mx.xperience.unicorn.fragments.StatusBarSettings"
        settings:layout="@layout/rainbow_dashboard_preference"
        android:icon="@drawable/ic_status_settings" />

    <!-- Lockscreen -->
    <Preference
        android:key="lockscreen"
        android:title="@string/lockscreen_settings_title"
        android:summary="@string/lockscreen_settings_summary"
        android:fragment="mx.xperience.unicorn.fragments.Lockscreen"
        settings:layout="@layout/rainbow_dashboard_preference"
        android:icon="@drawable/ic_clock" />

    <!-- Misc -->
    <Preference
        android:key="misc_category"
        android:title="@string/misc_title"
        android:summary="@string/rainbow_misc_summary"
        android:fragment="mx.xperience.unicorn.fragments.MiscSettings"
        settings:layout="@layout/rainbow_dashboard_preference"
        android:icon="@drawable/ic_misc_settings" />

    <!-- Spoofing -->
    <Preference
        android:key="spoofing"
        android:title="@string/miscellaneous_spoofing_category"
        android:summary="@string/rainbow_spoofing_summary"
        android:fragment="mx.xperience.unicorn.fragments.Spoofing"
        settings:layout="@layout/rainbow_dashboard_preference"
        android:icon="@drawable/ic_key" />

    <!-- Battery Adviser -->
    <Preference
        android:key="battery_adviser"
        android:title="@string/battery_adviser"
        android:summary="@string/battery_adviser_summary"
        android:icon="@drawable/ic_battery_adviser_settings"
        settings:layout="@layout/rainbow_dashboard_preference" />

</PreferenceScreen>
