<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/statusbar_title"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings">

    <PreferenceCategory
        android:title="UI Refactor">

        <SwitchPreferenceCompat
            android:key="new_status_bar_icons"
            android:title="Use new status bar icons"
            android:summary="Enables modernized icons. Disables most of statusbar customization."
            android:defaultValue="true" />

    </PreferenceCategory>

    <Preference
        android:key="systemui_tuner_statusbar"
        android:title="@string/statusbar_items_category" >
        <intent android:action="com.android.settings.action.STATUS_BAR_TUNER" />
    </Preference>

    <!-- Bluetooth battery status -->
    <mx.xperience.framework.preference.SystemSettingSwitchPreference
        android:key="bluetooth_show_battery"
        android:title="@string/status_bar_bluetooth_battery_title"
        android:summary="@string/status_bar_bluetooth_battery_summary"
        android:defaultValue="true" />

    <Preference
        android:key="network_traffic_settings"
        android:title="@string/network_traffic_settings_title"
        android:summary="@string/network_traffic_settings_summary"
        android:fragment="mx.xperience.unicorn.fragments.NetworkTrafficSettings" />

    <mx.xperience.framework.preference.SystemSettingSwitchPreference
        android:key="wifi_standard_icon"
        android:title="@string/wifi_standard_icon_title"
        android:summary="@string/wifi_standard_icon_summary"
        android:defaultValue="true"/>

   <!-- <mx.xperience.framework.preference.SystemSettingSwitchPreference
        android:key="show_fourg_icon"
        android:title="@string/show_fourg_icon_title"
        android:summary="@string/show_fourg_icon_summary"
        android:defaultValue="true"/>-->

    <Preference
        android:fragment="mx.xperience.unicorn.fragments.BatterySettings"
        android:key="battery_settings"
        android:title="@string/battery_settings_title"
        android:summary="@string/battery_settings_summary" />


    <mx.xperience.framework.preference.SystemSettingSwitchPreference
        android:key="statusbar_colored_icons"
        android:title="@string/statusbar_colored_icons_title"
        android:summary="@string/statusbar_colored_icons_summary"
        android:defaultValue="true" />

    <mx.xperience.framework.preference.SystemSettingSwitchPreference
        android:key="statusbar_notif_count"
        android:title="@string/statusbar_notif_count_title"
        android:summary="@string/statusbar_notif_count_summary"
        android:defaultValue="false" />

    <mx.xperience.framework.preference.SystemSettingSwitchPreference
        android:key="show_refresh_rate"
        android:title="@string/show_refresh_rate_title"
        android:summary="@string/show_refresh_rate_summary"
        android:defaultValue="false" />

    <Preference
        android:key="island_notification"
        android:title="@string/island_notification_title"
        android:summary="@string/island_notification_summary"
        android:fragment="mx.xperience.unicorn.fragments.IslandSettings" />

    <!-- Status bar chip bg style -->
    <mx.xperience.framework.preference.SystemSettingListPreference
        android:key="statusbar_clock_chip"
        android:title="@string/statusbar_clock_chip_title"
        android:entries="@array/statusbar_clock_chip_entries"
        android:entryValues="@array/statusbar_clock_chip_values"
        android:summary="%s"
        android:defaultValue="0" />

    <!-- ongoing progress -->
    <Preference
        android:key="ongoing_progress_settings"
        android:title="@string/ongoing_progress_settings_title"
        android:summary="@string/ongoing_progress_settings_summary"
        android:fragment="mx.xperience.unicorn.fragments.OngoingProgressBar" />

        <!-- Quick pull down -->
    <mx.xperience.framework.preference.SystemSettingListPreference
        android:key="qs_quick_pulldown"
        android:title="@string/status_bar_quick_pull_down_title"
        android:entries="@array/status_bar_quick_pull_down_entries"
        android:entryValues="@array/status_bar_quick_pull_down_values"
        android:defaultValue="0" />

</PreferenceScreen>
