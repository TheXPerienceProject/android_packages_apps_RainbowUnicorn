<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/statusbar_title">

    <Preference
        android:key="systemui_tuner_statusbar"
        android:title="@string/statusbar_items_category">
        <intent android:action="com.android.settings.action.STATUS_BAR_TUNER" />
    </Preference>

    <Preference
        android:fragment="mx.xperience.unicorn.fragments.BatterySettings"
        android:key="battery_settings"
        android:title="@string/battery_settings_title"
        android:summary="@string/battery_settings_summary" />

    <!--<mx.xperience.framework.preference.SystemSettingSwitchPreference
        android:key="qs_ios_control_panel"
        android:title="@string/ios_style"
        android:summary="@string/ios_style_summary"
        android:defaultValue="true" />

    <Preference
        android:key="cutout_progress"
        android:title="@string/cutout_progress_title"
        android:summary="@string/cutout_progress_summary"
        android:fragment="mx.xperience.unicorn.fragments.CutoutProgressSettingsFragment" />-->

    <PreferenceCategory
        android:key="dynamic_island_category"
        android:title="@string/status_bar_dynamic_island_title">

        <Preference
            android:key="status_bar_dynamic_island"
            android:fragment="mx.xperience.unicorn.fragments.statusbar.DynamicIslandSettings"
            android:summary="@string/status_bar_dynamic_island_summary"
            android:title="@string/status_bar_dynamic_island_title" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="dynamic_bar_category"
        android:title="@string/dynamic_bar_category_title">

        <Preference
            android:key="dynamic_bar"
            android:fragment="mx.xperience.unicorn.fragments.statusbar.DynamicBar"
            android:summary="@string/dynamic_bar_enable_summary"
            android:title="@string/dynamic_bar" />

    </PreferenceCategory>

    <!-- ongoing progress -->
    <!--<Preference
        android:key="ongoing_progress_settings"
        android:title="@string/ongoing_progress_settings_title"
        android:summary="@string/ongoing_progress_settings_summary"
        android:fragment="mx.xperience.unicorn.fragments.OngoingProgressBar" />

    <Preference
        android:key="network_traffic_settings"
        android:title="@string/network_traffic_settings_title"
        android:summary="@string/network_traffic_settings_summary"
        android:fragment="mx.xperience.unicorn.fragments.NetworkTrafficSettings" />-->

    <mx.xperience.framework.preference.SystemSettingSwitchPreference
        android:key="show_refresh_rate"
        android:title="@string/show_refresh_rate_title"
        android:summary="@string/show_refresh_rate_summary"
        android:defaultValue="true" />

    <mx.xperience.framework.preference.SystemSettingSwitchPreference
        android:key="status_bar_show_battery_estimate"
        android:title="@string/status_bar_battery_estimate_title"
        android:summary="@string/status_bar_battery_estimate_summary"
        android:defaultValue="true" />
</PreferenceScreen>
